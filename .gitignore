.DS_Store
agents/*/node_modules/
agents/*/*.log
**/.DS_Store

# Local secrets and credentials
.env
.env.*
!.env.example
*.key
*.pem
*.secret

# Agent-owned runtime data must never be committed. Runtime source code remains trackable.
agents/*/runtime-data/
agents/*/backups/
agents/*/exports/
agents/*/memory/*
!agents/*/memory/.gitignore
