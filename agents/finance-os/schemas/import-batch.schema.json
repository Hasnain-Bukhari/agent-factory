{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-factory.local/finance-os/schemas/import-batch.schema.json",
  "title": "Finance OS Import Batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "format", "source_name", "source_fingerprint", "encoding", "mapping_version", "created_at", "mode", "commit_mode", "rows"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "batch_id": { "type": "string", "format": "uuid" },
    "format": { "enum": ["csv", "json"] },
    "source_name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "source_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "encoding": { "enum": ["utf-8", "utf-16le"] },
    "mapping_version": { "type": "string", "minLength": 1, "maxLength": 40 },
    "created_at": { "type": "string", "format": "date-time" },
    "mode": { "enum": ["dry_run", "commit"] },
    "commit_mode": { "enum": ["atomic", "partial"] },
    "rows": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["row_number", "normalized_hash", "idempotency_key", "record_type", "payload"],
        "properties": {
          "row_number": { "type": "integer", "minimum": 1 },
          "normalized_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 200 },
          "record_type": { "enum": ["preferences", "account", "ledger_entry", "transfer", "investment", "liability", "budget", "goal", "net_worth_snapshot", "exchange_rate"] },
          "payload": { "type": "object" }
        },
        "allOf": [
          { "if": { "properties": { "record_type": { "const": "preferences" } } }, "then": { "properties": { "payload": { "$ref": "finance-store.schema.json#/$defs/preferences" } } } },
          { "if": { "properties": { "record_type": { "const": "account" } } }, "then": { "properties": { "payload": { "$ref": "finance-store.schema.json#/$defs/account" } } } },
          { "if": { "properties": { "record_type": { "const": "ledger_entry" } } }, "then": { "properties": { "payload": { "$ref": "finance-store.schema.json#/$defs/ledgerEntry" } } } },
          { "if": { "properties": { "record_type": { "const": "transfer" } } }, "then": { "properties": { "payload": { "$ref": "finance-store.schema.json#/$defs/transfer" } } } },
          { "if": { "properties": { "record_type": { "const": "investment" } } }, "then": { "properties": { "payload": { "$ref": "finance-store.schema.json#/$defs/investmentTransaction" } } } },
          { "if": { "properties": { "record_type": { "const": "liability" } } }, "then": { "properties": { "payload": { "$ref": "finance-store.schema.json#/$defs/liability" } } } },
          { "if": { "properties": { "record_type": { "const": "budget" } } }, "then": { "properties": { "payload": { "$ref": "finance-store.schema.json#/$defs/budget" } } } },
          { "if": { "properties": { "record_type": { "const": "goal" } } }, "then": { "properties": { "payload": { "$ref": "finance-store.schema.json#/$defs/goal" } } } },
          { "if": { "properties": { "record_type": { "const": "net_worth_snapshot" } } }, "then": { "properties": { "payload": { "$ref": "finance-store.schema.json#/$defs/netWorthSnapshot" } } } },
          { "if": { "properties": { "record_type": { "const": "exchange_rate" } } }, "then": { "properties": { "payload": { "$ref": "finance-store.schema.json#/$defs/exchangeRate" } } } }
        ]
      }
    }
  }
}
