{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-factory.local/finance-os/schemas/backup-manifest.schema.json",
  "title": "Finance OS Encrypted Backup Manifest",
  "description": "Metadata used to order, authenticate, and verify encrypted recoverable store generations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "backup_id", "store_id", "store_version", "generation", "created_at", "envelope_file", "ciphertext_sha256", "verification_status"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "backup_id": { "type": "string", "format": "uuid" },
    "store_id": { "type": "string", "format": "uuid" },
    "store_version": { "type": "integer", "minimum": 0 },
    "generation": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "envelope_file": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.enc$", "maxLength": 200 },
    "ciphertext_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "previous_backup_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "verification_status": { "enum": ["pending", "verified", "failed"] },
    "verified_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "verification_status": { "const": "verified" } }, "required": ["verification_status"] },
      "then": { "required": ["verified_at"] }
    }
  ]
}
