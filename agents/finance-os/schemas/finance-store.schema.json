{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-factory.local/finance-os/schemas/finance-store.schema.json",
  "title": "Finance OS Store",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "store_id",
    "store_version",
    "preferences",
    "accounts",
    "ledger_entries",
    "transfers",
    "investments",
    "liabilities",
    "budgets",
    "goals",
    "net_worth_snapshots",
    "exchange_rates",
    "audit_events",
    "idempotency_receipts"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "store_id": { "$ref": "#/$defs/uuid" },
    "store_version": { "type": "integer", "minimum": 0 },
    "preferences": { "$ref": "#/$defs/preferences" },
    "accounts": { "type": "array", "items": { "$ref": "#/$defs/account" } },
    "ledger_entries": { "type": "array", "items": { "$ref": "#/$defs/ledgerEntry" } },
    "transfers": { "type": "array", "items": { "$ref": "#/$defs/transfer" } },
    "investments": { "type": "array", "items": { "$ref": "#/$defs/investmentTransaction" } },
    "liabilities": { "type": "array", "items": { "$ref": "#/$defs/liability" } },
    "budgets": { "type": "array", "items": { "$ref": "#/$defs/budget" } },
    "goals": { "type": "array", "items": { "$ref": "#/$defs/goal" } },
    "net_worth_snapshots": { "type": "array", "items": { "$ref": "#/$defs/netWorthSnapshot" } },
    "exchange_rates": { "type": "array", "items": { "$ref": "#/$defs/exchangeRate" } },
    "audit_events": { "type": "array", "items": { "$ref": "#/$defs/auditEvent" } },
    "idempotency_receipts": { "type": "array", "items": { "$ref": "#/$defs/idempotencyReceipt" } }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "integerString": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)$"
    },
    "positiveDecimalString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minor_units", "currency"],
      "properties": {
        "minor_units": { "$ref": "#/$defs/integerString" },
        "currency": { "$ref": "#/$defs/currency" }
      }
    },
    "recordMeta": {
      "type": "object",
      "required": ["id", "created_at", "updated_at", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" },
        "status": { "enum": ["active", "archived"] }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_currency", "time_zone", "locale", "week_starts_on", "fiscal_year_start_month"],
      "properties": {
        "base_currency": { "$ref": "#/$defs/currency", "default": "THB" },
        "time_zone": { "type": "string", "minLength": 1, "default": "Asia/Bangkok" },
        "locale": { "type": "string", "minLength": 2, "default": "en-TH" },
        "week_starts_on": { "enum": ["monday", "sunday"] },
        "fiscal_year_start_month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "backup_retention_generations": { "type": "integer", "minimum": 1, "maximum": 365 },
        "confirm_above": { "$ref": "#/$defs/money" }
      }
    },
    "account": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/recordMeta" },
        {
          "type": "object",
          "required": ["name", "account_type", "currency", "include_in_net_worth"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 120 },
            "account_type": { "enum": ["cash", "bank", "e_wallet", "brokerage", "asset", "loan", "credit_card", "other"] },
            "currency": { "$ref": "#/$defs/currency" },
            "include_in_net_worth": { "type": "boolean" },
            "institution": { "type": "string", "maxLength": 120 },
            "notes": { "type": "string", "maxLength": 1000 }
          }
        }
      ]
    },
    "ledgerEntry": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/recordMeta" },
        {
          "type": "object",
          "required": ["entry_type", "account_id", "amount", "occurred_at", "posting_status", "idempotency_key"],
          "properties": {
            "entry_type": { "enum": ["income", "expense", "transfer_out", "transfer_in", "liability_draw", "liability_principal", "adjustment", "reversal"] },
            "account_id": { "$ref": "#/$defs/uuid" },
            "amount": { "$ref": "#/$defs/money" },
            "occurred_at": { "$ref": "#/$defs/timestamp" },
            "time_zone": { "type": "string", "minLength": 1 },
            "posting_status": { "enum": ["pending", "posted", "void"] },
            "category": { "type": "string", "maxLength": 120 },
            "description": { "type": "string", "maxLength": 500 },
            "transfer_id": { "$ref": "#/$defs/uuid" },
            "liability_id": { "$ref": "#/$defs/uuid" },
            "goal_id": { "$ref": "#/$defs/uuid" },
            "reverses_entry_id": { "$ref": "#/$defs/uuid" },
            "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 200 },
            "source": { "enum": ["manual", "import", "chatgpt", "telegram", "system"] }
          }
        },
        {
          "if": { "properties": { "entry_type": { "enum": ["transfer_out", "transfer_in"] } }, "required": ["entry_type"] },
          "then": { "required": ["transfer_id"] }
        },
        {
          "if": { "properties": { "entry_type": { "const": "reversal" } }, "required": ["entry_type"] },
          "then": { "required": ["reverses_entry_id"] }
        },
        {
          "if": { "properties": { "entry_type": { "enum": ["liability_draw", "liability_principal"] } }, "required": ["entry_type"] },
          "then": { "required": ["liability_id"] }
        }
      ]
    },
    "transfer": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/recordMeta" },
        {
          "type": "object",
          "required": ["source_account_id", "destination_account_id", "out_entry_id", "in_entry_id", "source_amount", "destination_amount", "occurred_at"],
          "properties": {
            "source_account_id": { "$ref": "#/$defs/uuid" },
            "destination_account_id": { "$ref": "#/$defs/uuid" },
            "out_entry_id": { "$ref": "#/$defs/uuid" },
            "in_entry_id": { "$ref": "#/$defs/uuid" },
            "source_amount": { "$ref": "#/$defs/money" },
            "destination_amount": { "$ref": "#/$defs/money" },
            "exchange_rate_id": { "$ref": "#/$defs/uuid" },
            "fee_entry_id": { "$ref": "#/$defs/uuid" },
            "occurred_at": { "$ref": "#/$defs/timestamp" }
          }
        }
      ]
    },
    "investmentTransaction": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/recordMeta" },
        {
          "type": "object",
          "required": ["account_id", "instrument_id", "transaction_type", "occurred_at", "cash_amount", "idempotency_key"],
          "properties": {
            "account_id": { "$ref": "#/$defs/uuid" },
            "instrument_id": { "type": "string", "minLength": 1, "maxLength": 120 },
            "transaction_type": { "enum": ["buy", "sell", "dividend", "fee", "split", "contribution", "withdrawal", "valuation"] },
            "quantity": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$" },
            "cash_amount": { "$ref": "#/$defs/money" },
            "unit_price": { "$ref": "#/$defs/money" },
            "fee_amount": { "$ref": "#/$defs/money" },
            "lot_method": { "const": "fifo" },
            "occurred_at": { "$ref": "#/$defs/timestamp" },
            "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 200 }
          }
        },
        {
          "if": { "properties": { "transaction_type": { "enum": ["buy", "sell"] } }, "required": ["transaction_type"] },
          "then": { "required": ["quantity", "unit_price", "lot_method"] }
        },
        {
          "if": { "properties": { "transaction_type": { "const": "split" } }, "required": ["transaction_type"] },
          "then": { "required": ["quantity"] }
        },
        {
          "if": { "properties": { "transaction_type": { "const": "valuation" } }, "required": ["transaction_type"] },
          "then": { "required": ["unit_price"] }
        }
      ]
    },
    "liability": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/recordMeta" },
        {
          "type": "object",
          "required": ["name", "liability_type", "currency", "include_in_net_worth"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 120 },
            "liability_type": { "enum": ["credit_card", "personal_loan", "mortgage", "student_loan", "tax", "other"] },
            "currency": { "$ref": "#/$defs/currency" },
            "include_in_net_worth": { "type": "boolean" },
            "annual_interest_rate": { "$ref": "#/$defs/positiveDecimalString" },
            "due_day": { "type": "integer", "minimum": 1, "maximum": 31 }
          }
        }
      ]
    },
    "budget": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/recordMeta" },
        {
          "type": "object",
          "required": ["name", "period", "limit", "starts_on"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 120 },
            "period": { "enum": ["weekly", "monthly", "quarterly", "yearly", "custom"] },
            "limit": { "$ref": "#/$defs/money" },
            "starts_on": { "type": "string", "format": "date" },
            "ends_on": { "type": "string", "format": "date" },
            "categories": { "type": "array", "items": { "type": "string", "maxLength": 120 }, "uniqueItems": true },
            "account_ids": { "type": "array", "items": { "$ref": "#/$defs/uuid" }, "uniqueItems": true }
          }
        }
      ]
    },
    "goal": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/recordMeta" },
        {
          "type": "object",
          "required": ["name", "goal_type", "target"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 120 },
            "goal_type": { "enum": ["savings", "debt_payoff", "investment", "purchase", "other"] },
            "target": { "$ref": "#/$defs/money" },
            "target_date": { "type": "string", "format": "date" },
            "linked_account_ids": { "type": "array", "items": { "$ref": "#/$defs/uuid" }, "uniqueItems": true },
            "linked_liability_ids": { "type": "array", "items": { "$ref": "#/$defs/uuid" }, "uniqueItems": true }
          }
        }
      ]
    },
    "valuationComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_id", "source_value", "base_value"],
      "properties": {
        "source_type": { "enum": ["account", "investment", "liability"] },
        "source_id": { "$ref": "#/$defs/uuid" },
        "source_value": { "$ref": "#/$defs/money" },
        "base_value": { "$ref": "#/$defs/money" },
        "exchange_rate_id": { "$ref": "#/$defs/uuid" },
        "price_observed_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "netWorthSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "valued_at", "base_currency", "assets", "liabilities", "net_worth", "components"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "valued_at": { "$ref": "#/$defs/timestamp" },
        "base_currency": { "$ref": "#/$defs/currency" },
        "assets": { "$ref": "#/$defs/money" },
        "liabilities": { "$ref": "#/$defs/money" },
        "net_worth": { "$ref": "#/$defs/money" },
        "components": { "type": "array", "items": { "$ref": "#/$defs/valuationComponent" } }
      }
    },
    "exchangeRate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "base_currency", "quote_currency", "rate", "observed_at", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "base_currency": { "$ref": "#/$defs/currency" },
        "quote_currency": { "$ref": "#/$defs/currency" },
        "rate": { "$ref": "#/$defs/positiveDecimalString" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "source": { "type": "string", "minLength": 1, "maxLength": 200 },
        "is_estimate": { "type": "boolean", "default": false }
      }
    },
    "auditEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "occurred_at", "actor_ref", "channel", "action", "target_ids", "previous_store_version", "new_store_version", "idempotency_key", "outcome", "previous_event_auth", "event_auth", "auth_algorithm", "key_version"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "occurred_at": { "$ref": "#/$defs/timestamp" },
        "actor_ref": { "type": "string", "minLength": 1, "maxLength": 200 },
        "channel": { "enum": ["local", "mcp", "chatgpt", "telegram", "import", "system"] },
        "action": { "type": "string", "minLength": 1, "maxLength": 120 },
        "target_ids": { "type": "array", "items": { "$ref": "#/$defs/uuid" }, "uniqueItems": true },
        "previous_store_version": { "type": "integer", "minimum": 0 },
        "new_store_version": { "type": "integer", "minimum": 0 },
        "idempotency_key": { "type": "string", "maxLength": 200 },
        "outcome": { "enum": ["accepted", "rejected", "integrity_failure"] },
        "previous_event_auth": { "type": "string", "minLength": 1, "maxLength": 512 },
        "event_auth": { "type": "string", "minLength": 16, "maxLength": 512 },
        "auth_algorithm": { "const": "HMAC-SHA-256" },
        "key_version": { "type": "integer", "minimum": 1 }
      }
    },
    "idempotencyReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "scope", "command_type", "accepted_at", "result_ids", "store_version", "request_hash", "input_hash", "status", "audit_id"],
      "properties": {
        "key": { "type": "string", "minLength": 8, "maxLength": 300 },
        "scope": { "type": "string", "minLength": 8, "maxLength": 300 },
        "command_type": { "type": "string", "minLength": 1, "maxLength": 120 },
        "accepted_at": { "$ref": "#/$defs/timestamp" },
        "result_ids": { "type": "array", "items": { "$ref": "#/$defs/uuid" }, "uniqueItems": true },
        "store_version": { "type": "integer", "minimum": 1 },
        "request_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "input_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "status": { "const": "accepted" },
        "audit_id": { "$ref": "#/$defs/uuid" },
        "balance_effects": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["account_id", "currency", "delta_minor_units"],
            "properties": {
              "account_id": { "$ref": "#/$defs/uuid" },
              "currency": { "$ref": "#/$defs/currency" },
              "delta_minor_units": { "$ref": "#/$defs/integerString" }
            }
          }
        },
        "import_batch_id": { "$ref": "#/$defs/uuid" },
        "import_mode": { "enum": ["atomic", "partial"] },
        "import_row_hashes": { "type": "array", "maxItems": 100000, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
        "import_rejected_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
