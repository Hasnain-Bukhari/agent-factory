{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-factory.local/finance-os/schemas/encryption-envelope.schema.json",
  "title": "Finance OS Authenticated Encryption Envelope",
  "description": "Structure only. Cryptographic validation and key handling are implementation responsibilities.",
  "type": "object",
  "additionalProperties": false,
  "required": ["envelope_version", "store_id", "store_schema_version", "algorithm", "key_id", "key_version", "nonce_b64", "aad_b64", "ciphertext_b64", "created_at"],
  "properties": {
    "envelope_version": { "const": "1" },
    "store_id": { "type": "string", "format": "uuid" },
    "store_schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "algorithm": { "enum": ["AES-256-GCM", "XCHACHA20-POLY1305"] },
    "key_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "key_version": { "type": "integer", "minimum": 1 },
    "nonce_b64": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$", "minLength": 16, "maxLength": 32 },
    "aad_b64": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$", "minLength": 4 },
    "ciphertext_b64": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$", "minLength": 24 },
    "wrapped_dek_b64": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$", "minLength": 24 },
    "kdf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "salt_b64", "memory_kib", "iterations", "parallelism"],
      "properties": {
        "algorithm": { "const": "ARGON2ID" },
        "salt_b64": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$", "minLength": 24, "maxLength": 128 },
        "memory_kib": { "type": "integer", "minimum": 65536 },
        "iterations": { "type": "integer", "minimum": 1 },
        "parallelism": { "type": "integer", "minimum": 1 }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "oneOf": [
        { "required": ["wrapped_dek_b64"], "not": { "required": ["kdf"] } },
        { "required": ["kdf"], "not": { "required": ["wrapped_dek_b64"] } }
      ]
    },
    {
      "if": { "properties": { "algorithm": { "const": "AES-256-GCM" } } },
      "then": { "properties": { "nonce_b64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{16}$" } } }
    },
    {
      "if": { "properties": { "algorithm": { "const": "XCHACHA20-POLY1305" } } },
      "then": { "properties": { "nonce_b64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{32}$" } } }
    }
  ]
}
