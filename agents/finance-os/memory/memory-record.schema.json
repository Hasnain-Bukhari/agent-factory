{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-factory.local/finance-os/memory-record.schema.json",
  "title": "Finance OS Private Memory Record",
  "description": "A user-confirmed continuity record. Canonical finance records and secrets are forbidden by the memory contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "memory_id",
    "profile_id",
    "memory_type",
    "status",
    "version",
    "purpose",
    "value",
    "source",
    "confirmation",
    "idempotency_key",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "memory_id": { "$ref": "#/$defs/uuid" },
    "profile_id": { "$ref": "#/$defs/uuid" },
    "memory_type": {
      "enum": ["preference", "alias", "categorization_rule", "import_mapping", "workflow_checkpoint"]
    },
    "status": { "enum": ["active", "archived", "expired"] },
    "version": { "type": "integer", "minimum": 1 },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 240 },
    "value": {
      "type": "object",
      "description": "Type-specific, non-secret value validated again by domain logic.",
      "minProperties": 1,
      "maxProperties": 20,
      "additionalProperties": true
    },
    "canonical_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/uuid" },
      "uniqueItems": true,
      "maxItems": 20,
      "default": []
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["user_statement", "reviewed_import", "system_default"] },
        "source_event_id": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed", "confirmed_at"],
      "properties": {
        "confirmed": { "const": true },
        "confirmed_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 200 },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
